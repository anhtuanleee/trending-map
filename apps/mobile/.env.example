EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Optional UI preview in demo mode only. Server-configured apps ignore this override.
EXPO_PUBLIC_DEMO_FEATURE_PREVIEW_KEYS=

# Subscription foundation is off by default. Enable layers progressively.
EXPO_PUBLIC_SUBSCRIPTIONS_ENABLED=false
EXPO_PUBLIC_SUBSCRIPTION_PAYWALL_ENABLED=false
EXPO_PUBLIC_SUBSCRIPTION_BILLING_ENABLED=false
EXPO_PUBLIC_SUBSCRIPTION_FOUNDER_OFFER_ENABLED=false
EXPO_PUBLIC_SUBSCRIPTION_ENABLED_FEATURES=
