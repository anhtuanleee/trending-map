{
  "name": "trending-map",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @trending-map/mobile start",
    "dev:mobile:clear": "pnpm --filter @trending-map/mobile start:clear",
    "dev:mobile:web": "pnpm --filter @trending-map/mobile web",
    "mobile:android": "pnpm --filter @trending-map/mobile android",
    "mobile:ios": "pnpm --filter @trending-map/mobile ios",
    "build:mobile:android": "pnpm --filter @trending-map/mobile export:android",
    "build:mobile:web": "pnpm --filter @trending-map/mobile export:web",
    "dev:admin": "pnpm --filter @trending-map/admin dev",
    "build:admin": "pnpm --filter @trending-map/admin build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.8.2",
    "typescript": "5.9.3"
  }
}


